# Los CSV de fixtures se cargan con BULK INSERT, que declara el terminador de
# fila de forma literal (0x0d0a). Si git los convirtiera segun la plataforma,
# el terminador declarado dejaria de coincidir y el retorno de carro acabaria
# dentro del ultimo campo de cada fila.
SmartNet/db/fixtures/data/*.csv text eol=crlf

# Los .sql tambien se ejecutan tal cual; conviene que no varien por plataforma.
*.sql text eol=crlf

# Datos maestros: binarios, git no debe tocarlos ni intentar hacer diff de texto.
*.xlsx binary

# Fixtures PDF (BACKLOG #6, WU2): contenido crudo con Length declarado por bytes exactos en cada
# stream — una conversion CRLF en checkout corrompe el documento (el largo declarado dejaria de
# coincidir con los bytes reales), igual riesgo que los CSV/SQL de arriba pero para binario.
*.pdf binary
